# Copy this to ai-service/.env and fill in GOOGLE_API_KEY.
#
#     cp .env.example .env
#
# Only this service needs these. The main app has its own .env.local.

# --- Required ---------------------------------------------------------------
# https://aistudio.google.com/apikey — free tier is enough for development.
# Without it: summarise, translate, grammar, OCR and chat all fail. The 21 PDF
# tools in the main app are unaffected; they never call this service.
GOOGLE_API_KEY=

# --- Optional, all have working defaults ------------------------------------
# The port this service listens on. Defaults to 8001, which is where the main
# app looks when AI_SERVICE_URL is unset, so the two line up with no config.
# PORT=8001

# Chroma, the vector store behind chat. Only "Chat with PDF" needs it —
# summarise, translate, grammar and OCR work without a Chroma server running.
# CHROMA_HOST=localhost
# CHROMA_PORT=8000

# GEMINI_MODEL=gemini-3.6-flash
