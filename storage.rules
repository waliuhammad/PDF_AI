rules_version = '2';

// Uploads live at users/{uid}/{docId}/{filename}, mirroring the Firestore
// layout so a user can only ever touch their own files.
service firebase.storage {
  match /b/{bucket}/o {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid}/{allPaths=**} {
      allow read: if isOwner(uid);
      allow delete: if isOwner(uid);

      // Size and type are enforced here as well as in the UI, because the UI
      // check is only a convenience — the client can always be bypassed.
      allow write: if isOwner(uid)
                   && request.resource.size < 25 * 1024 * 1024
                   && request.resource.contentType.matches(
                        'application/pdf|image/.*|application/msword|application/vnd\\..*'
                      );
    }
  }
}
