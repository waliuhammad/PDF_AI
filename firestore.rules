rules_version = '2';

// Everything a user owns nests under users/{uid}, so ownership is structural
// rather than something each rule has to re-derive.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);

      // A new account may only ever start on the free plan.
      allow create: if isOwner(uid)
                    && request.resource.data.plan == 'free';

      // plan is billing state. It must never be client-writable, or anyone
      // could grant themselves a paid subscription from the browser console.
      allow update: if isOwner(uid)
                    && request.resource.data.plan == resource.data.plan;

      allow delete: if false;

      match /documents/{docId} {
        allow read, write: if isOwner(uid);
      }
    }

    // Messages from the public contact form. Anyone may send one — the form is
    // on a public page — but nobody can read, edit or delete them from the
    // client, so the inbox is only visible in the console or to a server.
    //
    // The shape is validated here rather than trusted from the browser: without
    // these constraints the collection is an open write endpoint that anything
    // could fill with arbitrary documents.
    match /contactMessages/{messageId} {
      allow read, update, delete: if false;

      allow create: if request.resource.data.keys().hasOnly(
                         ['name', 'email', 'subject', 'message', 'createdAt']
                       )
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 100
                    && request.resource.data.email is string
                    && request.resource.data.email.size() > 0
                    && request.resource.data.email.size() <= 200
                    && request.resource.data.subject is string
                    && request.resource.data.subject.size() <= 200
                    && request.resource.data.message is string
                    && request.resource.data.message.size() > 0
                    && request.resource.data.message.size() <= 5000
                    && request.resource.data.createdAt == request.time;
    }

    // Anything not matched above is denied by default.
  }
}
